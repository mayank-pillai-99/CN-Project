# Team 1 settings used by every Phase 2 script.
#
# If anyone's Wi-Fi IP changes (check with:  ipconfig getifaddr en0),
# change it HERE and make sure all four Macs have the same copy of this file.
# NOTE: if Mac 3 or Mac 4 changes IP, Asad must also update the two "server"
# lines in nginx.conf, and Mayank's standby copy must be re-packed.

MAC1_IP=10.7.29.164   # Vikrant  - primary DNS (dnsmasq) + test client
MAC2_IP=10.7.26.179    # Asad     - edge: nginx, TLS, load balancer
MAC3_IP=10.7.18.13     # Mayank   - Backend A + backup DNS + standby edge
MAC4_IP=10.7.26.134   # Prashant - Backend B + main test client

DOMAIN_APP=app.team1.test
DOMAIN_API=api.team1.test
EDGE_PORT=8443
PORT_A=3001
PORT_B=3002

DNS_TTL=30            # seconds clients may cache a DNS answer (Extension B)
IFACE=en0             # Wi-Fi interface name on all four Macs
WIFI_SERVICE="Wi-Fi"  # network service name used by networksetup
